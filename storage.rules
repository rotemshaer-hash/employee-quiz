rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // רק החשבון של המשרד מעלה ומוחק. בלי זה, כל מי שפותח לעצמו משתמש היה יכול.
    function isAdmin() {
      return request.auth != null && request.auth.token.email.lower() == 'office@bedek-mivnim.co.il';
    }
    match /videos/{file} {
      allow read: if true;                                   // עובדים צופים בלי להתחבר
      // העלאה/החלפה: רק מנהל מחובר, רק וידאו, עד 500MB
      allow create, update: if isAdmin()
                   && request.resource.size < 500 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
      // מחיקה: רק מנהל מחובר. request.resource ריק במחיקה, ולכן אסור לבדוק גודל או סוג כאן —
      // בדיקה כזאת מכשילה כל מחיקה בשקט.
      allow delete: if isAdmin();
    }
    match /images/{file} {
      allow read: if true;                                   // עובדים צופים בלי להתחבר
      // העלאה/החלפה: רק מנהל מחובר, רק תמונה, עד 10MB
      allow create, update: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}

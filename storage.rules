rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{file} {
      allow read: if true;                                   // עובדים צופים בלי להתחבר
      // העלאה/החלפה: רק מנהל מחובר, רק וידאו, עד 500MB
      allow create, update: if request.auth != null
                   && request.resource.size < 500 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
      // מחיקה: רק מנהל מחובר. request.resource ריק במחיקה, ולכן אסור לבדוק גודל או סוג כאן —
      // בדיקה כזאת מכשילה כל מחיקה בשקט.
      allow delete: if request.auth != null;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}

{
  "rules": {
    "quizzes": {
      ".read": true,
      ".write": "auth != null"
    },
    "submissions": {
      ".read": true,
      "$quizId": {
        "$person": {
          ".write": "!data.exists() || auth != null",
          ".validate": "newData.hasChildren(['name','at'])"
        },
        ".write": "auth != null"
      }
    }
  }
}

{
  "rules": {
    "quizzes": {
      ".read": true,
      ".write": "auth != null"
    },
    "submissions": {
      ".read": true,
      "$quizId": {
        ".write": "auth != null",
        "$person": {
          ".write": "!data.exists() || auth != null",
          ".validate": "newData.hasChildren(['name','at'])"
        }
      }
    },
    "invites": {
      ".read": true,
      "$quizId": {
        ".write": "auth != null",
        "$code": {
          ".write": "auth != null || (data.exists() && !data.child('used').exists())"
        }
      }
    }
  }
}

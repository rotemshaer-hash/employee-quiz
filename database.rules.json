{
  "rules": {
    "quizzes": {
      ".read": true,
      ".write": "auth != null"
    },
    "library": {
      ".read": true,
      ".write": "auth != null"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null"
    },

    "submissions": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$quizId": {
        "$person": {
          ".write": "auth != null || !data.exists()",
          ".validate": "newData.hasChildren(['name','at'])",
          "mail": {
            ".write": "auth != null || data.parent().exists()",
            ".validate": "newData.isString() && newData.val().length < 10"
          }
        }
      }
    },

    "done": {
      ".read": true,
      ".write": "auth != null",
      "$quizId": {
        "$person": {
          ".write": "auth != null || !data.exists()",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "invites": {
      ".read": true,
      "$quizId": {
        ".write": "auth != null",
        "$code": {
          ".write": "auth != null",
          "used": {
            ".write": "auth != null || (data.parent().exists() && !data.parent().child('used').exists())",
            ".validate": "newData.isNumber()"
          },
          "name": {
            ".write": "auth != null || (data.parent().exists() && !data.parent().child('used').exists())",
            ".validate": "newData.isString() && newData.val().length < 80"
          }
        }
      }
    },

    "bundles": {
      ".read": true,
      "$bundleId": {
        ".write": "auth != null",
        "used": {
          ".write": "auth != null || (data.parent().exists() && !data.parent().child('used').exists())",
          ".validate": "newData.isNumber()"
        },
        "name": {
          ".write": "auth != null || (data.parent().exists() && !data.parent().child('used').exists())",
          ".validate": "newData.isString() && newData.val().length < 80"
        }
      }
    }
  }
}
